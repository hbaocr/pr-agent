# ==========================================
# PR-Agent Environment Configuration List
# ==========================================

# python -m pr_agent.cli --pr_url "https://scm.idlogiq.com/ID/rpm-backend/-/merge_requests/2362" review 

# -----------------
# Git Provider Settings (GitLab)
# -----------------
CONFIG__GIT_PROVIDER="gitlab"
GITLAB__URL="https://gitlab.com" # Change if using self-hosted GitLab
GITLAB__PERSONAL_ACCESS_TOKEN="your_gitlab_personal_access_token_here"
GITLAB__SHARED_SECRET="your_gitlab_webhook_secret_here" # Used to verify incoming webhooks from GitLab


# If using Anthropic, LiteLLM, or other providers, replace OPENAI.KEY with the appropriate env vars:
# ANTHROPIC_API_KEY="your_anthropic_api_key"

# --- Optional Overrides ---

# --- Config LLM---
#https://docs.litellm.ai/docs/providers

#for OpenAI llm model
#OPENAI__KEY="your_openai_api_key_here"
# https://docs.litellm.ai/docs/providers
#CONFIG__MODEL=gpt-5-mini



#for qwen model from Alibaba
#https://docs.litellm.ai/docs/providers/openai_compatible
#https://modelstudio.console.alibabacloud.com/ap-southeast-1?tab=doc#/doc/?type=model&url=2840914_2&modelId=qwen3.6-plus
CONFIG__CUSTOM_MODEL_MAX_TOKENS=32000
OPENAI__KEY=sk-xxxxx
OPENAI__API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#mean use open_api compatible, search on api_base then use model qwen3.6-plus
CONFIG__MODEL=openai/qwen3.6-plus


# -----------------
# OpenProject Integration
# -----------------
OPENPROJECT_URL="https://project.idlogiq.com"
OPENPROJECT_TOKEN="your_openproject_api_token_here"
