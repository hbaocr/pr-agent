# ==========================================
# PR-Agent Environment Configuration List
# ==========================================

# -----------------
# Git Provider Settings (GitLab)
# -----------------
CONFIG.GIT_PROVIDER="gitlab"
GITLAB.URL="https://gitlab.com" # Change if using self-hosted GitLab
GITLAB.PERSONAL_ACCESS_TOKEN="your_gitlab_personal_access_token_here"
GITLAB.SHARED_SECRET="your_gitlab_webhook_secret_here" # Used to verify incoming webhooks from GitLab

# -----------------
# AI Provider Settings (e.g. OpenAI)
# -----------------
OPENAI.KEY="your_openai_api_key_here"
# If using Anthropic, LiteLLM, or other providers, replace OPENAI.KEY with the appropriate env vars:
# ANTHROPIC_API_KEY="your_anthropic_api_key"

# -----------------
# OpenProject Integration
# -----------------
OPENPROJECT_URL="https://project.idlogiq.com"
OPENPROJECT_TOKEN="your_openproject_api_token_here"
